# Browser-safe Supabase Auth configuration. Replace every placeholder locally.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only configuration. Never prefix these variables with NEXT_PUBLIC_.
CREATOR_ANALYTICS_ALLOWED_EMAILS=operator@example.invalid
CREATOR_ANALYTICS_APP_ORIGIN=http://localhost:3000
# Use the migration-033 reader only. This placeholder disables TLS for a local
# sandbox; production must use the Supabase pooler with verified TLS.
CREATOR_ANALYTICS_DATABASE_URL=postgresql://creator_analytics_web_reader:replace-me@127.0.0.1:6543/postgres?sslmode=disable
CREATOR_ANALYTICS_POST_SYNC_STALE_HOURS=15
CREATOR_ANALYTICS_METRICS_STALE_HOURS=48
