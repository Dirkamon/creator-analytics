# Browser-safe Supabase Auth configuration. Replace every placeholder locally.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only configuration. Never prefix these variables with NEXT_PUBLIC_.
CREATOR_ANALYTICS_ALLOWED_EMAILS=operator@example.invalid
CREATOR_ANALYTICS_APP_ORIGIN=http://localhost:3000
# Use the migration-033 reader only. This placeholder disables TLS for a local
# sandbox; production must use the Supabase pooler with verified TLS.
CREATOR_ANALYTICS_DATABASE_URL=postgresql://creator_analytics_web_reader:replace-me@127.0.0.1:6543/postgres?sslmode=disable

# Phase 3 controlled labeling is disabled by default. Enable it only for local
# or staging origins after migration 035 and the dedicated labeler password are
# provisioned. Never reuse the reader or administrator connection here.
CREATOR_ANALYTICS_LABELING_ENABLED=false
CREATOR_ANALYTICS_LABELING_PRODUCTION_APPROVED=false
CREATOR_ANALYTICS_LABEL_DATABASE_URL=

# Phase 4 schedule decisions are disabled by default. This connection must use
# only the migration-037 approver role. Approvals queue the existing Make
# application workflow; the web app never writes to Buffer directly.
CREATOR_ANALYTICS_SCHEDULE_DECISIONS_ENABLED=false
CREATOR_ANALYTICS_SCHEDULE_DECISIONS_PRODUCTION_APPROVED=false
CREATOR_ANALYTICS_SCHEDULE_DATABASE_URL=

# Scheduling preferences: staging-only trial, never enabled for production.
# Requires migration 039 and a separately provisioned creator_analytics_web_scheduler
# credential for the SAME staging project as the reader. Neither field enables
# the database scheduler by itself; that requires a confirmed, audited save.
CREATOR_ANALYTICS_PREFERENCES_ENABLED=false
CREATOR_ANALYTICS_PREFERENCES_DATABASE_URL=
CREATOR_ANALYTICS_POST_SYNC_STALE_HOURS=15
CREATOR_ANALYTICS_METRICS_STALE_HOURS=48
